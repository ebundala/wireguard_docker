# WireGuard User and Timezone Configuration
PUID=1000
PGID=1000
TZ=UTC

# Port Forwarding Configuration
# PEER_IP: The VPN IP of your local dev machine (usually 10.13.13.2 for the first peer)
PEER_IP=10.13.13.2

# PUBLIC_PORT: The port exposed on the public OCI host IP that Google Apps Script calls
PUBLIC_PORT=80

# DEV_PORT: The port that your local development server runs on (e.g. 3000, 5000, 8000)
DEV_PORT=8080
