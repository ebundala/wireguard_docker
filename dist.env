# WireGuard User and Timezone Configuration
PUID=1000
PGID=1000
TZ=UTC

# Port Forwarding Configuration
# PEER_IP: The VPN IP of your local dev machine (usually 10.13.13.2 for the first peer)
PEER_IP=10.13.13.2

# FORWARD_PORTS: Comma-separated list of PUBLIC_PORT:DEV_PORT mappings.
# Format: <oci-port>:<local-port>,...
# This forwards port 80 (HTTP) and 443 (HTTPS) from the OCI server to your local machine.
FORWARD_PORTS=80:80,443:443
